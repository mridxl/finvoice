# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Which keys you need depends on the providers chosen at the bottom. The app starts
# without them; /api/health lists exactly what is missing and no call can be placed
# until those are set.

# --- Keys ---------------------------------------------------------------------

# Daily — WebRTC transport. Always required. Server-side only, never sent to the
# browser. https://dashboard.daily.co/developers
DAILY_API_KEY=

# Deepgram — speech-to-text, and text-to-speech if TTS_PROVIDER points at it.
# One key covers both seams. https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Cartesia — text-to-speech. Only while TTS_PROVIDER=cartesia, which is the
# default. If this account runs out of credit the call connects and then never
# speaks: set TTS_PROVIDER=deepgram below and this key is not needed at all.
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# OpenAI — the model, and OpenAI's STT or TTS if you point a seam at it.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio, for Gemini. Only while LLM_PROVIDER=google.
# Create the key in AI Studio rather than reusing an old one: Google rejects
# unrestricted standard keys and blocks dormant ones, and both states are visible
# only in the console — from here they look like an auth failure on the first
# turn. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Providers ----------------------------------------------------------------
# Defaults are the low-latency stack. Setting STT_PROVIDER and TTS_PROVIDER to
# "openai" runs everything on DAILY_API_KEY and OPENAI_API_KEY alone, for about
# 200-400ms more per reply. An unrecognised name here is reported at startup and
# refuses the call, rather than failing once someone has joined the room.

LLM_PROVIDER=openai       # openai | google
STT_PROVIDER=deepgram     # deepgram | openai
TTS_PROVIDER=cartesia     # cartesia | deepgram | openai

# Blank takes the selected provider's default — gpt-5.6-luna, or
# gemini-3.8-flash. Set it only to pin something else; a name from the wrong
# provider fails at the first turn, not at startup.
LLM_MODEL=

# Gemini only. Thinking tokens cost latency and bill at the output rate, so keep
# this as low as the model accepts: low | medium | high. gemini-3.8-flash
# rejects "minimal" — that was older Gemini's floor — and the server refuses to
# start a call on it rather than fail on the greeting.
GEMINI_THINKING_LEVEL=low

# OpenAI only, and the same problem: GPT-5 models reason before answering and
# default to "medium", which is seconds of silence on every turn.
# gpt-5.6-luna takes: none | low | medium | high | xhigh | max — note there is
# no "minimal" here, unlike Gemini. Supported values differ per model, so check
# the model's page before pinning something else.
#
# Only "none" works: the model refuses function tools on /v1/chat/completions
# at any other effort, and every turn of this agent carries tools. The server
# refuses to start a call on any other value rather than fail on the greeting.
OPENAI_REASONING_EFFORT=none

# --- Turn detection -----------------------------------------------------------
# smart = Smart Turn v3, a semantic end-of-turn model (recommended).
# vad   = fixed silence threshold, tuned by VAD_STOP_SECS.
TURN_DETECTION=smart

# Only read when TURN_DETECTION=vad. Pipecat's own default is 0.2s, which cuts
# people off while they are recalling a number.
VAD_STOP_SECS=0.8

# --- Server -------------------------------------------------------------------
PORT=8080

# Pipecat logs at debug by default and is chatty enough to put key material on
# screen. Turn it up deliberately, and back down before recording.
LOG_LEVEL=INFO

# The thirty-day window runs from today in India unless this is set. Pinning it
# makes a run reproducible, which is how the evals assert on a day of the month.
#
# ISO date, YYYY-MM-DD. AS_OF=2026-09-15 plans the fifteenth of September to the
# fourteenth of October — it runs across two months, which is what happens on any
# day but the first, and why the agent says the span aloud.
AS_OF=
