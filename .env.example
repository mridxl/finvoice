# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Which keys you need depends on the providers selected further down. The app
# starts without them and /api/health lists exactly what is missing for the
# combination you chose, but no call can be placed until they are set.

# --- Required, whatever you choose ------------------------------------------

# Daily — WebRTC transport. Server-side only; never sent to the browser.
# Get one at https://dashboard.daily.co/developers
DAILY_API_KEY=

# --- Required for the model you select ---------------------------------------
# Fill in the one matching LLM_PROVIDER below. OPENAI_API_KEY is also needed if
# you point STT_PROVIDER or TTS_PROVIDER at openai, whatever the model is.

# OpenAI. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio, for Gemini. https://aistudio.google.com/apikey
# Create the key in AI Studio rather than reusing an old one: Google now rejects
# unrestricted standard keys and blocks dormant ones, and keys made in AI Studio
# today are auth keys. A key in either of those states is tagged in the console.
GOOGLE_API_KEY=

# --- Required for the speech stack you select --------------------------------

# Deepgram — streaming speech-to-text, and text-to-speech if you point
# TTS_PROVIDER at it. One key covers both. https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Cartesia — streaming text-to-speech. Only needed while TTS_PROVIDER=cartesia.
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# --- Optional: the provider seam --------------------------------------------
# Defaults are the fast stack. Set STT_PROVIDER and TTS_PROVIDER to "openai" to
# run on DAILY_API_KEY and OPENAI_API_KEY alone, at the cost of latency.
# TTS_PROVIDER=deepgram is the other way to drop an account: one key then covers
# both speech seams, which is also the switch to reach for if Cartesia runs out.

LLM_PROVIDER=openai       # openai | google
STT_PROVIDER=deepgram     # deepgram | openai
TTS_PROVIDER=cartesia     # cartesia | deepgram | openai

# Leave blank to get the default for the provider above — gpt-5-mini for openai,
# gemini-3.8-flash for google. Set it only to pin something else; a name from the
# wrong provider fails at the first turn, not at startup.
LLM_MODEL=

# Gemini only. Gemini 3 models think before answering, and thinking tokens cost
# both latency and money (they bill at the output rate), so keep this as low as
# the model will accept. Options: minimal | low | medium | high
#
# "low" is the floor for gemini-3.8-flash and gemini-3.7-flash — both reject
# "minimal" with a 400 at the first turn. Only the Flash-Lite models take it.
GEMINI_THINKING_LEVEL=low

# --- Optional: turn detection -----------------------------------------------
# smart = Smart Turn v3, a semantic end-of-turn model (recommended).
# vad   = fixed silence threshold, tuned by VAD_STOP_SECS below.
TURN_DETECTION=smart

# Only used when TURN_DETECTION=vad. Pipecat's own default is 0.2s, which cuts
# people off while they recall a number. 0.8s is the tuned value for this domain.
VAD_STOP_SECS=0.8

# --- Optional: server -------------------------------------------------------
PORT=8080

# Pipecat logs at debug by default and is chatty enough to put key material on
# screen. Turn it up deliberately, and turn it back down before recording.
LOG_LEVEL=INFO

# --- Optional: pin the planning date ----------------------------------------
# The thirty-day window is measured from today in India unless this is set.
# Pinning it makes a run reproducible, which is how the evals assert on a
# particular day of the month. Leave it blank for normal use.
#
# ISO date, YYYY-MM-DD. AS_OF=2026-09-15 plans the fifteenth of September to
# the fourteenth of October — note that it runs across two months, which is
# what happens on any day but the first, and why the agent says the span aloud.
AS_OF=
